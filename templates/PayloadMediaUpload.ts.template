import {assertImageAsset,type ImageAsset} from '@add-cms/core/ImageControls';
import {assertFileAsset,type FileAsset} from '@add-cms/core/MappedResource';
import {assertVideoAsset,type VideoAsset} from '@add-cms/core/VideoControls';
import type {FileKind} from '@add-cms/core/FileChooser';
export const DIRECT_MEDIA_TYPES={image:['image/png','image/jpeg','image/webp'],file:['application/pdf'],video:['video/mp4','video/webm']} as const;
export type DirectAsset=ImageAsset|FileAsset|VideoAsset;
/** Payload's authenticated multipart protocol; each replacement creates a new private asset. */
export function createPayloadMediaUpload(collection:string){
 if(!/^[a-z][a-z0-9-]*$/.test(collection))throw Error('collection');
 return async function uploadPayloadMedia(file:File,kind:FileKind,alt?:string,signal?:AbortSignal):Promise<DirectAsset>{
 if(!file||!Number.isFinite(file.size)||file.size<1||file.size>8*1024*1024||!(DIRECT_MEDIA_TYPES[kind] as readonly string[]).includes(file.type)||!file.name||file.name.length>255||/[\\/\u0000-\u001f\u007f]/.test(file.name))throw Error('file');
 const data=new FormData();data.set('file',file);data.set('_payload',JSON.stringify({alt:alt||file.name,source:file.name,visibility:'draft'}));
 const response=await fetch('/api/'+collection+'?depth=0',{method:'POST',credentials:'same-origin',body:data,signal});if(!response.ok)throw Error('upload');
 const result=await response.json();const doc=result.doc;
 if(!doc||doc.visibility!=='draft'||!(DIRECT_MEDIA_TYPES[kind] as readonly string[]).includes(doc.mimeType))throw Error('file');
 return kind==='image'?assertImageAsset({id:doc.id,alt:doc.alt,width:doc.width,height:doc.height}):kind==='video'?assertVideoAsset(doc):assertFileAsset(doc);
}

}
